I’ve created agent.py, a working AI agent you can run on your own machine. I haven’t run it here because it needs your API key.

To use it:

Install the SDK with pip install anthropic.
Set your key in the ANTHROPIC_API_KEY environment variable.
Run python agent.py and chat with it. Try “What is (125 * 4) / 5, and what time is it?” to see it call both tools.
It has three parts:

Instructions: the SYSTEM_PROMPT defines the agent’s role and behavior.
Tools: it comes with a safe calculator and a clock. To add a capability, write a Python function and describe it in the TOOLS list.
Loop: the model decides whether to call a tool, the code runs it and returns the result, and this repeats until the model gives a final answer. MAX_STEPS stops it from looping forever.
#LE CODE PYTHON
"""
Minimal AI agent using the Anthropic API.

Setup:
    pip install anthropic
    export ANTHROPIC_API_KEY="your-key"   # Windows: set ANTHROPIC_API_KEY=your-key

Run:
    python agent.py
"""

import ast
import operator
from datetime import datetime

import anthropic

MODEL = "claude-sonnet-5-5"
MAX_STEPS = 10  # safety limit against infinite loops

SYSTEM_PROMPT = (
    "You are a helpful assistant. Use the tools when they help you answer "
    "accurately. If you are unsure, say so instead of guessing."
)

# ---------------------------------------------------------------------------
# 1. Tools: plain Python functions + a description the model can read
# ---------------------------------------------------------------------------

_OPS = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
    ast.Pow: operator.pow,
    ast.USub: operator.neg,
}


def _eval(node):
    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
        return node.value
    if isinstance(node, ast.BinOp) and type(node.op) in _OPS:
        return _OPS[type(node.op)](_eval(node.left), _eval(node.right))
    if isinstance(node, ast.UnaryOp) and type(node.op) in _OPS:
        return _OPS[type(node.op)](_eval(node.operand))
    raise ValueError("Unsupported expression")


def calculator(expression: str) -> str:
    """Safely evaluate a basic arithmetic expression."""
    try:
        return str(_eval(ast.parse(expression, mode="eval").body))
    except Exception as e:
        return f"Error: {e}"


def get_current_time() -> str:
    """Return the current local date and time."""
    return datetime.now().isoformat(timespec="seconds")


TOOL_FUNCTIONS = {
    "calculator": lambda args: calculator(args["expression"]),
    "get_current_time": lambda args: get_current_time(),
}

TOOLS = [
    {
        "name": "calculator",
        "description": "Evaluate a basic arithmetic expression such as '(12 + 8) * 3 / 4'.",
        "input_schema": {
            "type": "object",
            "properties": {
                "expression": {"type": "string", "description": "The arithmetic expression."}
            },
            "required": ["expression"],
        },
    },
    {
        "name": "get_current_time",
        "description": "Get the current local date and time.",
        "input_schema": {"type": "object", "properties": {}},
    },
]

# ---------------------------------------------------------------------------
# 2. The agent loop: model -> tool call -> result -> model ... -> final answer
# ---------------------------------------------------------------------------

client = anthropic.Anthropic()


def run_agent(user_message: str, history: list) -> str:
    history.append({"role": "user", "content": user_message})

    for _ in range(MAX_STEPS):
        response = client.messages.create(
            model=MODEL,
            max_tokens=1024,
            system=SYSTEM_PROMPT,
            tools=TOOLS,
            messages=history,
        )
        history.append({"role": "assistant", "content": response.content})

        # No tool requested: the model has produced its final answer.
        if response.stop_reason != "tool_use":
            return "".join(b.text for b in response.content if b.type == "text")

        # Execute every tool the model asked for and send the results back.
        results = []
        for block in response.content:
            if block.type == "tool_use":
                print(f"  [tool] {block.name}({block.input})")
                output = TOOL_FUNCTIONS[block.name](block.input)
                results.append(
                    {"type": "tool_result", "tool_use_id": block.id, "content": output}
                )
        history.append({"role": "user", "content": results})

    return "Stopped: step limit reached."


if __name__ == "__main__":
    print("AI agent ready. Type 'quit' to exit.")
    conversation = []  # short-term memory
    while True:
        text = input("\nYou: ").strip()
        if text.lower() in {"quit", "exit"}:
            break
        if text:
            print("Agent:", run_agent(text, conversation))
